NODE_ENV=development
PORT=3000

# Swagger UI at /api-docs (true | false)
SWAGGER_ENABLED=true

# MySQL (raw files metadata + extracted text)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=rag
MYSQL_USER=rag
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# Qdrant (vectors + metadata)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# Ollama (LLM + embedding)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=scb10x/typhoon2.1-gemma3-12b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIMENSION=1024
OLLAMA_TIMEOUT_MS=120000

# OCR (Typhoon OCR for images and scanned/broken-text PDF pages)
OLLAMA_OCR_MODEL=scb10x/typhoon-ocr1.5-3b
OLLAMA_OCR_TIMEOUT_MS=300000
# auto = OCR pages with no text or broken Thai text | always = OCR every page | never = no OCR
PDF_OCR_MODE=auto
OCR_MIN_PAGE_CHARS=30
OCR_BROKEN_THAI_THRESHOLD=3
OCR_MAX_IMAGE_DIMENSION=1800

# RAG
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_EMBED_BATCH_SIZE=16

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=20

# Host ports used by docker-compose
API_HOST_PORT=3000
MYSQL_HOST_PORT=3306
QDRANT_HOST_PORT=6333
OLLAMA_HOST_PORT=11434
